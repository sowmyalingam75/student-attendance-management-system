# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=student_attendance_db
DB_PORT=3306

# Database type: 'mysql' (default) or 'sqlite' (for standalone testing if MySQL is not installed)
DB_TYPE=mysql

# Application Security
SECRET_KEY=change_this_secret_key_to_a_random_value

# Flask Settings
FLASK_ENV=development
DEBUG=True
PORT=5000
